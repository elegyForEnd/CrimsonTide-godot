; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="血潮守望 · Crimson Tide"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio_bus.tres"

[autoload]

GraphicsQuality="*res://scripts/graphics_quality.gd"

[display]

; 窗口模式（全屏/窗口）与窗口尺寸**不在这里定**：它们由 autoload
; `scripts/graphics_quality.gd` 在 `_ready()` 里按 `scripts/window_settings.gd`
; 应用（首次下载默认全屏，之后继承玩家在设置页的选择/拖出来的尺寸）。
; 这里保留的是"还没跑到 autoload 的那一瞬间"的兜底窗口尺寸，改它只影响那一瞬间。
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/opening_baker/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
limits/global_shader_variables/buffer_size=1048576
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.045, 1)
