; Crimson Tide — native Godot 4 project
config_version=5

[application]
config/name="血潮守望 · Crimson Tide"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.045, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
buses/default_bus_layout="res://resources/audio_bus.tres"
