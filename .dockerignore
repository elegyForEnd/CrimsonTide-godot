# An allowlist keeps saves, Git history, exports and local secrets out of the context.
**
!Dockerfile
!.dockerignore
!project.godot
!game.cfg
!AUDIO-CREDITS.txt
!VOICE-CREDITS.txt
!scripts/
!scripts/**
!scenes/
!scenes/**
!resources/
!resources/**
!assets/
!assets/**
!server/
!server/app.py
!server/room.gd
!server/docker_entrypoint.py
!tests/
!tests/**
**/__pycache__/
**/*.pyc
**/*.import

!pv/
!pv/pv.ogv
