[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/boot.gd" id="1_boot"]

; 启动器场景 = 一个空壳（与 main.tscn 同一个约定：UI 全部由代码构建，见 §11.13）。
; 之所以连开场画面都不放在这里，是因为这个场景必须在**首次下载**时就能加载起来：
;  ① 任何字体/贴图的 ext_resource 都会在 `.godot/imported` 还空着的时候加载失败，
;     而 `.tscn` 的 ext_resource 加载失败是**整个场景**加载失败（黑屏）。
;  ② 实测：把带锚点的 Control 放进 `CanvasGroup`（第二批水滴转场要用它）之后，
;     `.tscn` 里写的锚点值不可靠——忠告会整块跑到屏幕左侧去。所以布局一律在
;     `boot.gd` 里按设计分辨率 1440×900 显式落一次。
; 根是 CanvasLayer 且 layer=100：必须盖在 main.tscn 的 CanvasLayer（默认 layer=1）
; 之上，进游戏时"擦掉启动器"才能露出下面的登录页。
[node name="Boot" type="CanvasLayer"]
layer = 100
script = ExtResource("1_boot")
